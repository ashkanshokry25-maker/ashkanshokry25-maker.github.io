{
  "name": "felinar door",
  "short_name": "door",
  "description": "Opens a site by its link, in a limited view that stores nothing for it. Version 0.3.0.",
  "id": "/_mw/open.html",
  "start_url": "/_mw/open.html",
  "scope": "/_mw/",
  "display": "standalone",
  "background_color": "#f6f7f9",
  "theme_color": "#f6f7f9",
  "icons": [
    {
      "src": "/_mw/icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+felinar",
      "url": "/_mw/open.html#%s"
    }
  ],
  "share_target": {
    "action": "/_mw/open.html",
    "method": "GET",
    "params": {
      "url": "mw",
      "text": "mwtext"
    }
  },
  "launch_handler": {
    "client_mode": "navigate-existing"
  }
}
